<Window x:Class="GroundStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="ME72 DREDGE CHALLENGE — GROUND CONTROL STATION" Height="820" Width="1300"
        Background="#111215" Foreground="#E5E7EB"
        FontFamily="Segoe UI" FontSize="12"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- MINIMALIST PALETTE (ZERO ROUNDED CORNERS) -->
        <SolidColorBrush x:Key="WindowBg" Color="#111215"/>
        <SolidColorBrush x:Key="PanelBg" Color="#16181D"/>
        <SolidColorBrush x:Key="SubPanelBg" Color="#131418"/>
        <SolidColorBrush x:Key="DividerBorder" Color="#2D323C"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A91A0"/>

        <!-- Sharp Rectangular Button Style -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#1A1D24"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#2D323C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252A35"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B5363"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E3442"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="SharpComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" Background="#1A1D24" BorderBrush="#2D323C" BorderThickness="1" CornerRadius="0" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8A91A0" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#4B5363" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Sharp ComboBox Style -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="#1A1D24"/>
            <Setter Property="BorderBrush" Value="#2D323C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource SharpComboBoxToggleButton}" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,2,24,2" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1A1D24" BorderThickness="1" BorderBrush="#2D323C" CornerRadius="0"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp ComboBox Item Style -->
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Background" Value="#1A1D24"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border Name="Border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#252A35"/>
                                <Setter Property="Foreground" Value="#FACC15"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#2E3442"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sharp Slider Style -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>
    </Window.Resources>

    <!-- MONOLITHIC EDGE-TO-EDGE GRID (SINGLE DIVIDING LINES, NO OUTER MARGIN) -->
    <Grid Background="#111215">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP TOOLBAR TILE (SINGLE BOTTOM LINE) ================= -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#2D323C" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="SERIAL PORT:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#8A91A0"/>
                <ComboBox x:Name="PortComboBox" Grid.Column="1" Width="110" Height="26" Margin="0,0,6,0"/>
                <Button x:Name="RefreshPortsBtn" Grid.Column="2" Content="REFRESH" Width="75" Height="26" Margin="0,0,6,0" Click="RefreshPortsBtn_Click"/>
                <Button x:Name="ConnectBtn" Grid.Column="3" Content="CONNECT (921600)" Width="145" Height="26" Click="ConnectBtn_Click"/>

                <TextBlock Grid.Column="5" Text="DRIVE MODE:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#8A91A0"/>
                <ComboBox x:Name="DriveModeCombo" Grid.Column="6" Width="220" Height="26" SelectionChanged="DriveModeCombo_SelectionChanged">
                    <ComboBoxItem Content="Single-Stick (Left Stick Only)" IsSelected="True"/>
                    <ComboBoxItem Content="Split-Stick (Left Y + Right X)"/>
                    <ComboBoxItem Content="Dual-Stick Tank (Left Y + Right Y)"/>
                </ComboBox>

                <!-- Status & Packet Rate -->
                <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" Background="#1A1D24" BorderBrush="#DC2626" BorderThickness="1" Padding="8,3" Margin="0,0,12,0">
                        <TextBlock x:Name="StatusText" Text="LINK OFFLINE" FontWeight="Bold" FontSize="11" Foreground="#DC2626"/>
                    </Border>
                    <TextBlock x:Name="FpsLabel" Text="0.0 Hz | 0 pkts" Foreground="#8A91A0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
                </StackPanel>

                <!-- Emergency Stop (Vector SVG Octagon) -->
                <Button x:Name="EStopBtn" Grid.Column="10" Width="175" Height="28" Background="#B91C1C" Foreground="#FFFFFF" FontWeight="Bold" BorderBrush="#DC2626" BorderThickness="1" Click="EStopBtn_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path x:Name="EStopIcon" Data="M 4.7,0 L 11.3,0 L 16,4.7 L 16,11.3 L 11.3,16 L 4.7,16 L 0,11.3 L 0,4.7 Z"
                              Fill="#FFFFFF" Width="13" Height="13" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock x:Name="EStopText" Text="EMERGENCY STOP" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ================= MAIN WORKSPACE (SEAMLESS 2-COLUMN SPLIT) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: AXIS TUNING (RIGHT BORDER DIVIDER) -->
            <Border Grid.Column="0" Background="#16181D" BorderBrush="#2D323C" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- AXIS TUNING HEADER WITH CURVE SELECTION PINNED TO FAR RIGHT -->
                    <Border Grid.Row="0" BorderBrush="#2D323C" BorderThickness="0,0,0,1" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AXIS TUNING" FontWeight="Bold" Foreground="#8A91A0" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CURVE:" Foreground="#8A91A0" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                <ComboBox x:Name="CurveTypeCombo" Width="145" SelectionChanged="CurveTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Gamma (Power)" IsSelected="True"/>
                                    <ComboBoxItem Content="Cubic Polynomial"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- VERTICAL AXIS (THROTTLE) CELL -->
                    <Border Grid.Row="1" BorderBrush="#2D323C" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="ThrottleAxisTitle" Text="VERTICAL AXIS" FontWeight="Bold" Foreground="#E5E7EB" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ThrottlePointText" Text="(+0.00, +0.00)" Foreground="#8A91A0" FontSize="12" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Deadband:" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <Slider x:Name="ThrottleDeadbandSlider" Grid.Column="1" Minimum="0.00" Maximum="0.25" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="TuningSlider_ValueChanged"/>
                                    <TextBlock x:Name="ThrottleDeadbandText" Grid.Column="2" Text="0.08" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ThrottleCurveLabel" Grid.Column="0" Text="Gamma:" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <Slider x:Name="ThrottleCurveSlider" Grid.Column="1" Minimum="1.00" Maximum="4.00" Value="1.90" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="TuningSlider_ValueChanged"/>
                                    <TextBlock x:Name="ThrottleCurveText" Grid.Column="2" Text="1.90" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- ScottPlot 5 Throttle Scope with Unclipped Topmost Marker Overlay -->
                            <Border Grid.Column="1" Background="#131418" BorderBrush="#2D323C" BorderThickness="1" Width="220" Height="220" HorizontalAlignment="Right">
                                <Grid Width="220" Height="220">
                                    <sp:WpfPlot x:Name="ThrottlePlot" Width="220" Height="220"/>
                                    <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                        <Ellipse x:Name="ThrottleMarkerDot" Width="9" Height="9" Fill="#FFFFFF" Stroke="#111215" StrokeThickness="1"/>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- HORIZONTAL AXIS (STEERING) CELL -->
                    <Border Grid.Row="2" BorderBrush="#2D323C" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock x:Name="SteerAxisTitle" Text="HORIZONTAL AXIS" FontWeight="Bold" Foreground="#E5E7EB" FontSize="12" Margin="0,0,0,4"/>
                                <TextBlock x:Name="SteerPointText" Text="(+0.00, +0.00)" Foreground="#8A91A0" FontSize="12" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Deadband:" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <Slider x:Name="SteerDeadbandSlider" Grid.Column="1" Minimum="0.00" Maximum="0.25" Value="0.08" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="TuningSlider_ValueChanged"/>
                                    <TextBlock x:Name="SteerDeadbandText" Grid.Column="2" Text="0.08" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SteerCurveLabel" Grid.Column="0" Text="Gamma:" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <Slider x:Name="SteerCurveSlider" Grid.Column="1" Minimum="1.00" Maximum="4.00" Value="1.90" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="TuningSlider_ValueChanged"/>
                                    <TextBlock x:Name="SteerCurveText" Grid.Column="2" Text="1.90" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- ScottPlot 5 Steering Scope with Unclipped Topmost Marker Overlay -->
                            <Border Grid.Column="1" Background="#131418" BorderBrush="#2D323C" BorderThickness="1" Width="220" Height="220" HorizontalAlignment="Right">
                                <Grid Width="220" Height="220">
                                    <sp:WpfPlot x:Name="SteerPlot" Width="220" Height="220"/>
                                    <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                        <Ellipse x:Name="SteerMarkerDot" Width="9" Height="9" Fill="#FFFFFF" Stroke="#111215" StrokeThickness="1"/>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SAFETY LIMITS CELL (CAUTION ORANGE) -->
                    <Border Grid.Row="3" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="SAFETY LIMITS" FontWeight="Bold" Foreground="#FB923C" FontSize="11" Margin="0,0,0,12"/>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Max Forward Limit with Generous Spacing -->
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Max Forward:" Foreground="#8A91A0" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MaxFwdValText" Grid.Column="1" Text="100%" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>
                                    <Slider x:Name="MaxFwdSlider" Minimum="0.50" Maximum="1.00" Value="1.00" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="TuningSlider_ValueChanged"/>
                                </StackPanel>

                                <!-- Max Reverse Limit with Generous Spacing -->
                                <StackPanel Grid.Column="1" Margin="7,0,7,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Max Reverse:" Foreground="#8A91A0" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MaxRevValText" Grid.Column="1" Text="75%" Foreground="#FB923C" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>
                                    <Slider x:Name="MaxRevSlider" Minimum="0.30" Maximum="1.00" Value="0.75" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="TuningSlider_ValueChanged"/>
                                </StackPanel>

                                <!-- Slew Rate with Generous Spacing -->
                                <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Slew Rate:" Foreground="#8A91A0" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SlewValText" Grid.Column="1" Text="50" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </Grid>
                                    <Slider x:Name="SlewSlider" Minimum="10" Maximum="150" Value="50" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="TuningSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANE: COLLECTOR 1 PROPULSION & ROBOT STATE -->
            <Border Grid.Column="1" Background="#16181D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP STATUS HEADER WITH CONTROLLER CONNECTED PINNED TO FAR RIGHT -->
                    <Border Grid.Row="0" BorderBrush="#2D323C" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COLLECTOR 1 PROPULSION TEST" FontWeight="Bold" Foreground="#8A91A0" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ControllerStatusText" Grid.Column="1" Text="CONTROLLER CONNECTED" Foreground="#22C55E" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- STICK POSITION CELL (DUAL STICK VISUALIZERS SIDE-BY-SIDE) -->
                    <Border Grid.Row="1" BorderBrush="#2D323C" BorderThickness="0,0,0,1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Stick Scope (LX, LY) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="LEFT STICK" FontSize="10" FontWeight="Bold" Foreground="#8A91A0" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                <Border Background="#131418" BorderBrush="#2D323C" BorderThickness="1" Width="130" Height="130">
                                    <Grid Width="130" Height="130">
                                        <sp:WpfPlot x:Name="LeftStickPlot" Width="130" Height="130"/>
                                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                            <Ellipse x:Name="LeftStickMarkerDot" Width="9" Height="9" Fill="#FFFFFF" Stroke="#111215" StrokeThickness="1"/>
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Right Stick Scope (RX, RY) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="RIGHT STICK" FontSize="10" FontWeight="Bold" Foreground="#8A91A0" Margin="0,0,0,6" HorizontalAlignment="Center"/>
                                <Border Background="#131418" BorderBrush="#2D323C" BorderThickness="1" Width="130" Height="130">
                                    <Grid Width="130" Height="130">
                                        <sp:WpfPlot x:Name="RightStickPlot" Width="130" Height="130"/>
                                        <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                            <Ellipse x:Name="RightStickMarkerDot" Width="9" Height="9" Fill="#FFFFFF" Stroke="#111215" StrokeThickness="1"/>
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Stick Telemetry & Readouts -->
                            <StackPanel Grid.Column="3" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="STICK TELEMETRY" Foreground="#8A91A0" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Left (LX, LY):" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="LeftInputText" Grid.Column="1" Text="(+0.00, +0.00)" Foreground="#E5E7EB" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Mag:" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="LeftMagText" Grid.Column="3" Text="0.00" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="45"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Right (RX, RY):" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="RightInputText" Grid.Column="1" Text="(+0.00, +0.00)" Foreground="#E5E7EB" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Mag:" Foreground="#8A91A0" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBlock x:Name="RightMagText" Grid.Column="3" Text="0.00" Foreground="#E5E7EB" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- UNIFIED ROBOT STATE CELL (SEPARATED THRUSTER BARS + AUXILIARY) -->
                    <Border Grid.Row="2" Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ROBOT STATE" FontWeight="Bold" Foreground="#8A91A0" FontSize="11" Margin="0,0,0,10"/>

                            <!-- UPPER SECTION: SEPARATED THRUSTER METERS WITH TICKS AND FLANKING READOUTS -->
                            <Grid Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Microsecond value fixed directly above each corresponding bar (Wider bounds to prevent clipping) -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/> <!-- Left % offset -->
                                        <ColumnDefinition Width="38"/> <!-- Left bar width -->
                                        <ColumnDefinition Width="36"/> <!-- Space between bars -->
                                        <ColumnDefinition Width="38"/> <!-- Right bar width -->
                                        <ColumnDefinition Width="65"/> <!-- Right % offset -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Thruster Header (Wider bounds centered directly over Left Bar) -->
                                    <StackPanel Grid.Column="1" Width="80" Margin="-21,0,-21,0" HorizontalAlignment="Center">
                                        <TextBlock Text="LEFT" FontSize="9" FontWeight="Bold" Foreground="#8A91A0" TextAlignment="Center"/>
                                        <TextBlock x:Name="LeftUsText" Text="1500 µs" FontSize="13" FontWeight="Bold" Foreground="#E5E7EB" TextAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Right Thruster Header (Wider bounds centered directly over Right Bar) -->
                                    <StackPanel Grid.Column="3" Width="80" Margin="-21,0,-21,0" HorizontalAlignment="Center">
                                        <TextBlock Text="RIGHT" FontSize="9" FontWeight="Bold" Foreground="#8A91A0" TextAlignment="Center"/>
                                        <TextBlock x:Name="RightUsText" Text="1500 µs" FontSize="13" FontWeight="Bold" Foreground="#E5E7EB" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Separated Bars with Internal 25/50/75/100% Ticks & Live % on Flanks -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/> <!-- Immediate Left: Live % -->
                                        <ColumnDefinition Width="38"/> <!-- Left Bar -->
                                        <ColumnDefinition Width="36"/> <!-- Space between bars -->
                                        <ColumnDefinition Width="38"/> <!-- Right Bar -->
                                        <ColumnDefinition Width="65"/> <!-- Immediate Right: Live % -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Live Percentage to the Immediate Left of Left Bar -->
                                    <TextBlock x:Name="LeftPctText" Grid.Column="0" Text="+0%" Foreground="#E5E7EB" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,8,0"/>

                                    <!-- Left Thruster Bar Enclosure -->
                                    <Border Grid.Column="1" Background="#0E0F12" BorderBrush="#2D323C" BorderThickness="1" Width="38" Height="178">
                                        <Canvas x:Name="LeftMeterCanvas" Width="36" Height="176" ClipToBounds="True">
                                            <!-- Internal Tick Lines: 25, 50, 75, 100% each direction (no labels) -->
                                            <Line X1="0" Y1="0" X2="36" Y2="0" Stroke="#2D323C" StrokeThickness="1"/>
                                            <Line X1="0" Y1="22" X2="14" Y2="22" Stroke="#262A33" StrokeThickness="1"/>
                                            <Line X1="0" Y1="44" X2="20" Y2="44" Stroke="#2D323C" StrokeThickness="1"/>
                                            <Line X1="0" Y1="66" X2="14" Y2="66" Stroke="#262A33" StrokeThickness="1"/>
                                            <!-- Centerline 1500 us (Y = 88) -->
                                            <Line X1="0" Y1="88" X2="36" Y2="88" Stroke="#4A5060" StrokeThickness="1"/>
                                            <Line X1="0" Y1="110" X2="14" Y2="110" Stroke="#262A33" StrokeThickness="1"/>
                                            <Line X1="0" Y1="132" X2="20" Y2="132" Stroke="#2D323C" StrokeThickness="1"/>
                                            <Line X1="0" Y1="154" X2="14" Y2="154" Stroke="#262A33" StrokeThickness="1"/>
                                            <Line X1="0" Y1="176" X2="36" Y2="176" Stroke="#2D323C" StrokeThickness="1"/>
                                            <!-- Dynamic Bar -->
                                            <Rectangle x:Name="LeftMeterBar" Width="36" Height="0" Fill="#22C55E" Canvas.Left="0" Canvas.Top="88"/>
                                        </Canvas>
                                    </Border>

                                    <!-- Right Thruster Bar Enclosure -->
                                    <Border Grid.Column="3" Background="#0E0F12" BorderBrush="#2D323C" BorderThickness="1" Width="38" Height="178">
                                        <Canvas x:Name="RightMeterCanvas" Width="36" Height="176" ClipToBounds="True">
                                            <!-- Internal Tick Lines: 25, 50, 75, 100% each direction (no labels) -->
                                            <Line X1="0" Y1="0" X2="36" Y2="0" Stroke="#2D323C" StrokeThickness="1"/>
                                            <Line X1="22" Y1="22" X2="36" Y2="22" Stroke="#262A33" StrokeThickness="1"/>
                                            <Line X1="16" Y1="44" X2="36" Y2="44" Stroke="#2D323C" StrokeThickness="1"/>
                                            <Line X1="22" Y1="66" X2="36" Y2="66" Stroke="#262A33" StrokeThickness="1"/>
                                            <!-- Centerline 1500 us (Y = 88) -->
                                            <Line X1="0" Y1="88" X2="36" Y2="88" Stroke="#4A5060" StrokeThickness="1"/>
                                            <Line X1="22" Y1="110" X2="36" Y2="110" Stroke="#262A33" StrokeThickness="1"/>
                                            <Line X1="16" Y1="132" X2="36" Y2="132" Stroke="#2D323C" StrokeThickness="1"/>
                                            <Line X1="22" Y1="154" X2="36" Y2="154" Stroke="#262A33" StrokeThickness="1"/>
                                            <Line X1="0" Y1="176" X2="36" Y2="176" Stroke="#2D323C" StrokeThickness="1"/>
                                            <!-- Dynamic Bar -->
                                            <Rectangle x:Name="RightMeterBar" Width="36" Height="0" Fill="#22C55E" Canvas.Left="0" Canvas.Top="88"/>
                                        </Canvas>
                                    </Border>

                                    <!-- Live Percentage to the Immediate Right of Right Bar -->
                                    <TextBlock x:Name="RightPctText" Grid.Column="4" Text="+0%" Foreground="#E5E7EB" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextAlignment="Left" Margin="8,0,0,0"/>
                                </Grid>
                            </Grid>

                            <!-- LOWER SECTION: STAR ROLLER & DEPLOY ARM (BORDER TOP DIVIDER) -->
                            <Border Grid.Row="2" BorderBrush="#2D323C" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="INTAKE STAR ROLLER" FontSize="10" Foreground="#8A91A0"/>
                                        <TextBlock x:Name="RollerValText" Text="0 PWM (OFF)" FontSize="12" FontWeight="SemiBold" Foreground="#E5E7EB" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="DEPLOY ARM ACTUATOR" FontSize="10" Foreground="#8A91A0"/>
                                        <TextBlock x:Name="ArmValText" Text="HOLD (0x00)" FontSize="12" FontWeight="SemiBold" Foreground="#E5E7EB" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= FOOTER TILE (SINGLE TOP LINE) ================= -->
        <Border Grid.Row="2" Background="#16181D" BorderBrush="#2D323C" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock Text="CALTECH ME72 DREDGE CHALLENGE — RF ESP-NOW RELAY (CH 13 / 802.11 LR MODE)" Foreground="#6B7280" FontSize="10"/>
                <TextBlock Text="PRESS [BACK] ON XBOX CONTROLLER FOR E-STOP" Foreground="#DC2626" FontSize="10" FontWeight="Bold" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
